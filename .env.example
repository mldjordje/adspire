# Adspire — environment contract. Copy to .env.local and fill in.
# No secrets belong in this file.

# --- Neon Postgres (Adspire OS) --------------------------------------------
# Until this exists, /api/leads still works and falls back to SMTP notification.
DATABASE_URL=

# Signs the /os session cookie. Min. 16 karaktera; rotacija izbacuje sve sesije.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OS_SESSION_SECRET=

# --- Lead notification (interim, cPanel SMTP) ------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when empty.
LEAD_NOTIFICATION_TO=

# --- Resend (see docs/faza-0-resend-setup.md) ------------------------------
# Transactional only. The outreach key lives in n8n, never in this repo.
RESEND_API_KEY_TRANSACTIONAL=
RESEND_FROM_TRANSACTIONAL="Adspire Digital <djordje@send.adspire.rs>"

# Adspire — environment contract. Copy to .env.local and fill in.
# No secrets belong in this file.

# --- Public site and optional Google measurement ---------------------------
NEXT_PUBLIC_SITE_URL=https://adspire.rs
# Leave empty until the corresponding Google properties exist. Google scripts
# load only after a visitor accepts the measurement banner.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Neon Postgres (Adspire OS) --------------------------------------------
# Until this exists, /api/leads still works and falls back to SMTP notification.
DATABASE_URL=

# Signs the /os session cookie. Min. 16 karaktera; rotacija izbacuje sve sesije.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OS_SESSION_SECRET=

# --- Mail transport --------------------------------------------------------
# Resend is used when both RESEND_* are set; otherwise cPanel SMTP. See
# docs/mail-resend-cpanel.md for the DNS steps.

# cPanel mailbox (djordje@adspire.rs). Works today; also the fallback.
SMTP_HOST=mail.adspire.rs
SMTP_PORT=465
SMTP_USER=djordje@adspire.rs
SMTP_PASS=
# Defaults to SMTP_USER when empty.
LEAD_NOTIFICATION_TO=

# Resend. `from` must sit on a domain verified in Resend — use the sending
# subdomain so the root MX (cPanel webmail) stays untouched.
RESEND_API_KEY=
RESEND_FROM="Adspire Digital <djordje@send.adspire.rs>"

# Where a client's reply lands. The cPanel mailbox, always.
MAIL_REPLY_TO=djordje@adspire.rs

# --- Mesečne pretplate (cron) ----------------------------------------------
# Without CRON_SECRET the cron route refuses to run at all. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# "1" mails each generated invoice to the client automatically. Leave empty to
# issue only and send by hand from /os/fakture/mesecno.
RECURRING_AUTOSEND=

# --- Client portal Google login (optional) ----------------------------------
# Without both, /nalog/prijava shows only the email link. In Google Cloud add
# the authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/portal/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI crawler measurement (Vercel Log Drain) ------------------------------
# Without these, /api/logs/drain answers 404 to everything and /os/analitika
# measures only the routes that record themselves (/llms.txt, /llms-full.txt).
# Both values are generated by Vercel, so they can only be filled in after the
# drain wizard runs: Vercel -> Project -> Observability -> Log Drains, source
# "Logs", destination https://adspire.rs/api/logs/drain.
#
# Shown by the wizard before the drain exists; the endpoint echoes it back so
# Vercel can prove we own it. Set this first, redeploy, then verify.
VERCEL_LOG_DRAIN_VERIFY=
# Shown after the drain is created. Every delivery is signed with it
# (HMAC-SHA1 of the raw body). Set this second, redeploy again.
VERCEL_LOG_DRAIN_SECRET=
